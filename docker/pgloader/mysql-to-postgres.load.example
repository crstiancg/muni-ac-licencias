-- Copy local MySQL data into the production Postgres (data only).
--
-- 1. The Postgres schema must already exist: deploy the app once, its first
--    start runs `php artisan migrate` (AUTORUN). Never let pgloader create
--    tables: Laravel's migrations define the types the app expects.
-- 2. cp mysql-to-postgres.load.example mysql-to-postgres.load and fill in the
--    URLs (the .load file is git-ignored: it holds passwords).
-- 3. Run it (see docker/README.md).
--
-- The MySQL user needs mysql_native_password: pgloader does not speak
-- MySQL 8's default caching_sha2_password.

LOAD DATABASE
     FROM mysql://MYSQL_USER:MYSQL_PASSWORD@host.docker.internal:3306/MYSQL_DATABASE
     INTO postgresql://PG_USER:PG_PASSWORD@PG_HOST:5432/PG_DATABASE

WITH data only,
     truncate,
     disable triggers,
     reset sequences,
     workers = 4,
     concurrency = 1

CAST type tinyint when (= precision 1) to boolean drop typemod using tinyint-to-boolean,
     type datetime to timestamp drop default drop not null using zero-dates-to-null,
     type timestamp to timestamp drop default drop not null using zero-dates-to-null,
     type date to date drop default drop not null using zero-dates-to-null

-- Framework bookkeeping: Postgres keeps its own migrations table; sessions,
-- cache and jobs are disposable.
EXCLUDING TABLE NAMES MATCHING 'migrations', 'sessions', 'cache', 'cache_locks',
     'jobs', 'job_batches', 'failed_jobs', 'password_reset_tokens'

-- MySQL's schema is the database name; Laravel's tables live in "public".
ALTER SCHEMA 'MYSQL_DATABASE' RENAME TO 'public';
